msgstr "格式為「<name> <value>」"

#: common/config.cpp:74
msgid "string"
msgstr "字串"

#: common/config.cpp:74
msgid "integer"
msgstr "整數"

#: common/config.cpp:74
msgid "boolean"
msgstr "布林值"

#: common/config.cpp:74
msgid "list"
msgstr "清單"

